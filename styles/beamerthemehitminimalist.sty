%% 本文件只负责视觉外观：蓝色标题栏、浅灰画布、顶部章节导航、白色封面等。
%% 公共命令与通用版式由 beamercmdhit.sty 提供，各主题共用。
%%
%% 更新记录
%%   v2.2026a 2026/10/09  主题正式迁移为 Minimalist（原 Academic 风格）；
%%                         适配 v2 共享架构与跨主题接口。
%%   v2.3     2026/10/02  接入公共内容层；不再重定义内容组件，只配置颜色与字号。
%%   v2.2     2026/10/01  首次以独立主题形式提供 Academic 风格。
%%
%% Usage:
%%   \documentclass[aspectratio=169]{ctexbeamer}
%%   \usetheme[minimalist]{hit}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehitminimalist}[2026/10/09 v2.2026a HIT beamer minimalist theme]

\RequirePackage{iftex}
\RequireXeTeX

\mode<presentation>

% 主题加载标记与公共命令层。
\def\hit@theme@loaded{}
\def\hit@theme@name{hitminimalist}
\def\hit@theme@minimalist{}
\RequirePackage{beamercmdhit}

% 单独加载本文件时补全选项开关默认值
\@ifundefined{ifhit@serif}{\newif\ifhit@serif}{}
\@ifundefined{ifhit@sans}{\newif\ifhit@sans}{}
\@ifundefined{ifhit@top}{\newif\ifhit@top}{}
\@ifundefined{ifhit@navsymbols}{\newif\ifhit@navsymbols}{}
\@ifundefined{ifhit@sectionpage}{\newif\ifhit@sectionpage}{}
\@ifundefined{ifhit@opt@sectionpage}{\newif\ifhit@opt@sectionpage}{}

% 字体支持：沿用标准 ctex/TeX Live 配置，serif 选项启用衬线字体
\ifhit@serif
  \usefonttheme[stillsansserifmath]{serif}
\fi

\RequirePackage{totcount}
\@ifundefined{c@hit@sectiontotal}{\newcounter{hit@sectiontotal}\regtotcounter{hit@sectiontotal}}{}

% 正文垂直对齐：默认居中，top 选项改为顶部对齐
\ifhit@top\beamer@centeredfalse\fi

% Minimalist 主题默认不插入章节过渡页（除非显式指定 sectionpage 选项）
\ifhit@opt@sectionpage
  \hit@sectionpagetrue
\else
  \hit@sectionpagefalse
\fi

% 表格与代码排版设置（仅 minimalist 主题生效）
\renewcommand{\arraystretch}{1.08}
\setlength{\tabcolsep}{4.5pt}
\AtBeginDocument{%
  \@ifpackageloaded{tabularx}{%
    \renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{##1}}%
  }{}%
}
\lstset{
  language=C++,
  basicstyle=\ttfamily\fontsize{7.3}{10}\selectfont,
  keywordstyle=\color{brand}\bfseries,
  commentstyle=\color{muted},
  stringstyle=\color{good},
  showstringspaces=false,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  backgroundcolor=\color{pale},
  frame=none,
  aboveskip=5pt,
  belowskip=5pt,
  xleftmargin=5pt,
  xrightmargin=5pt,
  rulecolor=\color{linegray}
}

% ----------------------------------------------------------------- colors ----
\definecolor{brand}{HTML}{0070BE}
\definecolor{cyan}{HTML}{00A3D9}
\definecolor{ink}{HTML}{263B4D}
\definecolor{muted}{HTML}{526779}
\definecolor{pale}{HTML}{EDF4FA}
\definecolor{canvas}{HTML}{F7F9FB}
\definecolor{linegray}{HTML}{D5E0E8}
\definecolor{risk}{HTML}{BD5A32}
\definecolor{good}{HTML}{287763}

\colorlet{hitprimary}{brand}
\colorlet{hitneutraldarkest}{ink}
\colorlet{hitneutrallightest}{pale}
\colorlet{hitneutrallight}{linegray}

\setbeamercolor{normal text}{fg=ink,bg=canvas}
\setbeamercolor{background canvas}{bg=canvas}
\setbeamercolor{frametitle}{fg=white,bg=brand}
\setbeamercolor{itemize item}{fg=brand}
\setbeamercolor{alerted text}{fg=risk}
\setbeamercolor{structure}{fg=brand}
\setbeamercolor{palette primary}{fg=white,bg=brand}
\setbeamercolor{block title}{fg=brand,bg=pale}
\setbeamercolor{block body}{fg=ink,bg=pale}

% ------------------------------------------------------------------ fonts ----
% 字体尺寸与系列配置（通过 Beamer 字体接口设置）
\setbeamerfont{normal text}{size=\fontsize{9.5}{13}}
\setbeamerfont{frametitle}{size=\fontsize{15}{19},series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{9.5}{13},series=\mdseries}
\setbeamerfont{hit outline title}{size=\fontsize{20}{24},series=\bfseries}

% 正文边距与通用模板
\setbeamersize{text margin left=.7cm,text margin right=.7cm}
\ifhit@navsymbols\else\setbeamertemplate{navigation symbols}{}\fi
\setbeamertemplate{background}{}
\setbeamertemplate{section in head/foot}{\colorbox{brand}{\strut\color{white}\bfseries\insertsectionhead}}
\setbeamertemplate{section in head/foot shaded}{\colorbox{canvas}{\strut\color{muted}\insertsectionhead}}
\setbeamertemplate{itemize items}{\raisebox{.15ex}{\tiny\color{brand}$\bullet$}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{section in toc}{%
  \color{brand}\inserttocsectionnumber\quad\color{ink}\inserttocsection\par\vspace{3mm}}
\setbeamertemplate{section in toc shaded}{%
  \color{muted!50}\inserttocsectionnumber\quad\inserttocsection\par\vspace{3mm}}

% 章节过渡页实现（仅在开启 sectionpage 选项时触发）
\newcommand{\hit@minimalist@sectionframe}{%
  \begin{frame}
    \setbox\@tempboxa=\vbox{\hsize=\textwidth
      \tableofcontents[sectionstyle=show/shaded,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]}%
    \@tempdima=\dimexpr\textheight-2pt\relax
    \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax>\@tempdima
      \hit@scaleboxto\@tempboxa{\@tempdima}%
    \fi
    \noindent\box\@tempboxa
  \end{frame}}
\AtBeginSection[]{%
  \stepcounter{hit@sectiontotal}%
  \ifhit@sectionpage
    \hit@minimalist@sectionframe
  \fi}

% ---------------------------------------------------------------- headline ----
% 固定页眉高度；章节名称由正文自动生成，当前章节显示蓝色背景。
% 导航盒子的测量与输出在同一分组内完成，保留局部赋值。
\def\hit@logopath{\hitvipath hit-vi-logo-horizontal}
\newdimen\hit@navavail
\newsavebox\hit@navbox
\newsavebox\hit@headbox
\newcommand{\hit@navavailwd}{\dimexpr\paperwidth-3.0cm-1.4cm\relax}
% 测量副本按自然宽度装箱，保留 Beamer 的章节筛选与跳转实现。
\let\hit@navnatural\insertsectionnavigationhorizontal
\patchcmd{\hit@navnatural}{\hbox to #1}{\hbox}{}{%
  \PackageError{beamerthemehitminimalist}{Cannot measure section navigation}%
    {The Beamer section navigation implementation has changed.}}
\newcommand{\hit@nav}{%
  \insertsectionnavigationhorizontal{\hit@navavailwd}{}{\hfill}}
\newcommand{\hit@headnav}{%
  \begingroup
  \setbox\hit@navbox=\hbox{\fontsize{7.7}{10}\selectfont
    \let\insertsectionnavigationhorizontal\hit@navnatural
    \hit@nav}%
  \hit@navavail=\hit@navavailwd
  \ifdim\wd\hit@navbox>\hit@navavail
    \setbox\hit@navbox=\hbox{\resizebox{\hit@navavail}{!}{\box\hit@navbox}}%
  \else
    \setbox\hit@navbox=\hbox{\fontsize{7.7}{10}\selectfont\hit@nav}%
  \fi
  \hbox to\hit@navavail{\unhbox\hit@navbox\hfil}%
  \endgroup}
\setbeamertemplate{headline}{%
  \sbox\hit@headbox{\hbox{\hspace{.7cm}%
    \parbox[c][.67cm][c]{3.0cm}{\includegraphics[width=2.9cm]{\hit@logopath}}%
    \parbox[c][.67cm][c]{\hit@navavailwd}{\hit@headnav}}}%
  \hbox to \paperwidth{\hss\box\hit@headbox\hss}%
  \nointerlineskip{\color{linegray}\rule{\paperwidth}{.45pt}}}

% -------------------------------------------------------------- frametitle ----
\setbeamercolor{framesubtitle}{fg=white}
\setbeamerfont{framesubtitle}{size=\fontsize{9.5}{13},series=\mdseries}
\setbeamertemplate{frametitle}{%
  \vskip1.2mm
  \begin{beamercolorbox}[wd=\textwidth,sep=.20cm,leftskip=.03cm,rightskip=.03cm]{frametitle}
    \usebeamerfont{frametitle}\strut\insertframetitle\strut
    \ifx\insertframesubtitle\@empty\else
      \par\vskip.8mm
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\strut\insertframesubtitle\strut}%
    \fi
  \end{beamercolorbox}\vskip0.9mm}

% ---------------------------------------------------------------- footline ----
\providecommand{\hit@footerleft}{\insertshortinstitute}
\setbeamertemplate{footline}{%
  \hbox to\paperwidth{\hspace{.7cm}\color{muted}\fontsize{6.3}{8}\selectfont
    \hit@footerleft\hfill\insertpagenumber\hspace{.7cm}}\vskip2.3mm}

% ==================================================== 公共命令的主题实现 ====
% ------------------------------------------------------------- title page ----
\def\hit@titleslidepage{%
  \vspace{.1cm}
  \begin{center}\includegraphics[width=4.4cm]{\hit@logopath}\end{center}
  \vspace{.22cm}
  \begin{beamercolorbox}[wd=\textwidth,sep=.4cm,center]{palette primary}
    {\fontsize{23}{30}\selectfont\bfseries\inserttitle\par}
    \ifx\insertsubtitle\@empty\else
      \vspace{.22cm}{\fontsize{11.5}{15}\selectfont\insertsubtitle\par}%
    \fi
  \end{beamercolorbox}
  \vspace{.22cm}
  \begin{center}\small
    \insertauthor\par\smallskip
    \insertinstitute\par\smallskip\insertdate
  \end{center}}

% ------------------------------------------------------------- focus slide ----
\long\def\hit@focuspage#1{%
  \setbeamercolor{background canvas}{bg=brand}%
  \begin{frame}[plain]
    \color{white}\vspace{6mm}
    {\fontsize{25}{34}\selectfont\bfseries #1\par}\vspace{6mm}
    {\color{cyan}\rule{3cm}{2pt}}
  \end{frame}}

% -------------------------------------------------------------- end slides ----
\long\def\hit@endpage#1{%
  \begin{frame}[plain]
    \centering\includegraphics[width=4.4cm]{\hit@logopath}\par\vspace{.9cm}
    {\color{brand}\fontsize{26}{34}\selectfont\bfseries #1\par}
  \end{frame}}

% ---------------------------------------------------------------- appendix ----
% 附录里把顶部章节导航换成 APPENDIX 标记。
\apptocmd{\appendix}{\renewcommand{\hit@nav}{\hfill\color{muted}APPENDIX\hspace{.4cm}}}{}{}

\mode<all>
\endinput
