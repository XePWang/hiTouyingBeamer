%% beamerthemehitacademic.sty
%% 哈尔滨工业大学 Beamer 幻灯片主题 · Academic 风格
%%
%% License: LaTeX Project Public License 1.3c
%%
%% 本文件是 Academic 主题 hitacademic 的样式：蓝色标题栏、浅灰画布、顶部章节导航、
%% 双语封面与内容组件。命令层在 beamercmdhit.sty 里，本主题会自动加载它。
%% 与经典主题 hit 共用同一套公共命令，改主题行即可切换视觉风格。
%%
%% 派生自 hithesis/hiTouyingBeamer 提交 a1b947ed63671135884f4417d2c91cb9e9555b59，
%% 上游作者 SchrodingerBlume（LPPL 维护者）。修改记录与维护信息见 CHANGELOG.md、README.md。
%%
%% Usage:
%%   \documentclass[aspectratio=169,11pt,fontset=none]{ctexbeamer}
%%   \usetheme{hitacademic}
%%
%% 字体与素材：
%%   字体来自 hit-fonts.sty 加载的 fonts/ 目录；覆盖封面标识用 \hitlogo{文件路径}，
%%   插图目录用 \renewcommand{\hit@figpath}{...}。

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehitacademic}[2026/10/01 v2.2 hiTouyingBeamer Academic]

\RequirePackage{iftex}
\RequireXeTeX

\mode<presentation>

% 主题加载标记。beamercmdhit.sty 里的公共命令据此选择主题实现。
\def\hit@theme@loaded{}
% 当前主题名，供公共命令区分两套实现。
\def\hit@theme@name{hitacademic}
% 公共命令层。先加载它，本文件随后覆盖其中的样式钩子。
\RequirePackage{beamercmdhit}

\RequirePackage{lmodern}
\RequirePackage{hit-fonts}
\RequirePackage{booktabs,tabularx,array,listings,amsmath,bm,colortbl,etoolbox}
\usefonttheme{professionalfonts}

% ----------------------------------------------------------------- colors ----
\definecolor{brand}{HTML}{0070BE}
\definecolor{cyan}{HTML}{00A3D9}
\definecolor{ink}{HTML}{263B4D}
\definecolor{muted}{HTML}{526779}
\definecolor{pale}{HTML}{EDF4FA}
\definecolor{canvas}{HTML}{F7F9FB}
\definecolor{linegray}{HTML}{D5E0E8}
\definecolor{risk}{HTML}{BD5A32}
\definecolor{good}{HTML}{287763}
\setbeamercolor{normal text}{fg=ink,bg=canvas}
\setbeamercolor{background canvas}{bg=canvas}
\setbeamercolor{frametitle}{fg=white,bg=brand}
\setbeamercolor{itemize item}{fg=brand}
\setbeamercolor{alerted text}{fg=risk}
\setbeamercolor{structure}{fg=brand}
\setbeamercolor{palette primary}{fg=white,bg=brand}
\setbeamercolor{block title}{fg=brand,bg=pale}
\setbeamercolor{block body}{fg=ink,bg=pale}
\setbeamercolor{hit insight}{fg=ink,bg=pale}
\setbeamercolor{hit note rule}{fg=risk}
\setbeamercolor{hit content muted}{fg=muted}
\setbeamercolor{hit agenda list number}{fg=brand}
\setbeamercolor{hit outline rule}{fg=linegray}
\setbeamerfont{hit agenda list number}{size=\fontsize{13}{16}\selectfont,series=\bfseries}

\setbeamersize{text margin left=.58cm,text margin right=.58cm}
\setbeamerfont{normal text}{size=\fontsize{9.5}{13}\selectfont}
\setbeamerfont{frametitle}{size=\fontsize{15}{19}\selectfont,series=\bfseries}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{background}{}
\setbeamertemplate{section in head/foot}{\colorbox{brand}{\strut\color{white}\bfseries\insertsectionhead}}
\setbeamertemplate{section in head/foot shaded}{\colorbox{canvas}{\strut\color{muted}\insertsectionhead}}

% ------------------------------------------------------ 素材与配置入口 ----
\newcommand{\hit@logo}{assets/hit-logo.png}
\newcommand{\hitlogo}[1]{\renewcommand{\hit@logo}{#1}}
\newcommand{\hit@footer}{\insertshorttitle}
\renewcommand{\hitfooter}[1]{\renewcommand{\hit@footer}{#1}}
\newcommand{\hit@nav}{\insertsectionnavigationhorizontal{.70\paperwidth}{}{\hfill}}

% ---------------------------------------------------------------- headline ----
\setbeamertemplate{headline}{%
  \hbox{\hspace{.58cm}%
    \parbox[c][.67cm][c]{.24\paperwidth}{\includegraphics[width=2.9cm]{\hit@logo}}%
    \parbox[c][.67cm][c]{.70\paperwidth}{\fontsize{7.7}{10}\selectfont\hit@nav}}%
  \nointerlineskip{\color{linegray}\rule{\paperwidth}{.45pt}}}

% -------------------------------------------------------------- frametitle ----
\setbeamertemplate{frametitle}{%
  \vskip1.7mm
  \begin{beamercolorbox}[wd=\textwidth,sep=.20cm,leftskip=.03cm,rightskip=.03cm]{frametitle}
    \usebeamerfont{frametitle}\strut\insertframetitle\strut
  \end{beamercolorbox}\vskip1.2mm}

% ---------------------------------------------------------------- footline ----
\setbeamertemplate{footline}{%
  \hbox to\paperwidth{\hspace{.58cm}\color{muted}\fontsize{6.3}{8}\selectfont
    \hit@footer\hfill\insertpagenumber\hspace{.58cm}}\vskip2.3mm}

\setbeamertemplate{itemize items}{\raisebox{.15ex}{\tiny\color{brand}$\bullet$}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{section in toc}{\color{brand}\inserttocsectionnumber\quad\color{ink}\inserttocsection\par\vspace{3mm}}
\lstset{language=C++,basicstyle=\ttfamily\fontsize{7.3}{10}\selectfont,
  keywordstyle=\color{brand}\bfseries,commentstyle=\color{muted},stringstyle=\color{good},
  showstringspaces=false,breaklines=true,columns=fullflexible,keepspaces=true,
  backgroundcolor=\color{pale},frame=none,aboveskip=5pt,belowskip=5pt,
  xleftmargin=5pt,xrightmargin=5pt,rulecolor=\color{linegray}}
\renewcommand{\arraystretch}{1.18}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\setlength{\tabcolsep}{5pt}
\AtBeginEnvironment{frame}{\bodytext}
\AtBeginDocument{\renewcommand{\normalsize}{\fontsize{9.5}{13}\selectfont}\normalsize}

% ==================================================== 公共命令的主题实现 ====
% 封面：校徽、蓝色标题栏、双语标题、作者信息。
\setbeamertemplate{hit title slot}{%
  {\fontsize{12.1}{16}\selectfont\hit@english\par}}
% 结束页附注。
\setbeamertemplate{hit end slot}{{\color{muted}\insertshorttitle\par}}

% 内容组件：主题配色。
\renewcommand{\subhead}[1]{\par{\color{brand}\bfseries #1}\par\vspace{1.4mm}}
\renewcommand{\captiontext}[1]{{\fontsize{7.7}{10}\selectfont\color{muted}#1\par}}
\renewcommand{\metric}[3]{\begin{minipage}[t]{#1}\color{brand}%
  \usebeamerfont{hit content metric}\bfseries #2\par\vspace{1.5mm}%
  {\color{muted}\usebeamerfont{hit content metric note}\mdseries #3}\end{minipage}}

\renewcommand{\insight}[1]{\par\vspace{2mm}\noindent\colorbox{pale}{%
  \parbox{\dimexpr\linewidth-2\fboxsep}{\vspace{.8mm}%
    \color{brand}\bfseries\fontsize{9}{12}\selectfont #1\vspace{.8mm}}}\par}
\renewcommand{\notebox}[1]{%
  \par\vspace{1.5mm}\noindent
  \sbox{\hit@notebox}{\begin{minipage}[t]{\dimexpr\linewidth-8pt}%
    \fontsize{8}{11}\selectfont #1\end{minipage}}%
  {\color{risk}\rule[-\dp\hit@notebox]{2pt}{\dimexpr\ht\hit@notebox+\dp\hit@notebox\relax}}%
  \hspace{1.5mm}\usebox{\hit@notebox}\par}

% ------------------------------------------------------------- title page ----
\renewcommand{\hit@titleslidepage}{%
  \vspace{.1cm}
  \begin{center}\includegraphics[width=4.4cm]{\hit@logo}\end{center}
  \vspace{.22cm}
  \begin{beamercolorbox}[wd=\textwidth,sep=.4cm,center]{palette primary}
    {\fontsize{23}{30}\selectfont\bfseries\inserttitle\par}
    \vspace{.38cm}
    \usebeamertemplate*{hit title slot}
  \end{beamercolorbox}
  \vspace{.22cm}
  \begin{center}\smalltext
    \hit@source\par\vspace{.14cm}\insertauthor\par\smallskip
    \insertinstitute\par\smallskip\insertdate
  \end{center}}

% ----------------------------------------------------------------- outline ----
% 自动目录：读取正文主章节。2–6 项用版块版式，其余数量用主题一致的普通列表。
\renewcommand{\hit@OutlineSlide@themed}[1][]{%
  \begingroup
  \hit@outlineoptions{#1}%
  \hit@collectsections
  \hit@renderoutline
  \endgroup}

% 版块版式：左侧标题色块、右侧编号与圆角横条。
% 这段用 expl3 语法书写，必须在 \ExplSyntaxOn 内定义带下划线与冒号的命令名。
\ExplSyntaxOn
\cs_set_protected:Npn \hit_agenda_block_available:TF #1#2 { #1 }
\cs_set_protected:Npn \hit_agenda_paint_block:
  {
    \fill[canvas] (0,0) rectangle (1,1);
    \fill[brand!40!white] (-.02,.255) -- (.18,.255)
      arc[start~angle=-90,end~angle=90,x~radius=.15,y~radius=.245]
      -- (-.02,.745) -- cycle;
    \fill[brand] (-.02,.27) -- (.18,.27)
      arc[start~angle=-90,end~angle=90,x~radius=.137,y~radius=.23]
      -- (-.02,.73) -- cycle;
    \node[text=white,align=center,text~width=.28\paperwidth,
      font=\bfseries\fontsize{32}{36}\selectfont,inner~sep=0pt]
      at (.157,.55) {\hit@agendatitle};
    \node[text=white,align=center,text~width=.28\paperwidth,
      font=\bfseries\fontsize{10.5}{13}\selectfont,inner~sep=0pt]
      at (.157,.415) {\hit@agendasubtitle};
  }
% 列表版式：与主题一致的普通章节列表，条目不截断。
\cs_set_protected:Npn \hit_agenda_draw_list:
  {
    \setbox\hit@agendalistbox=\vbox{\hsize=\textwidth\hit@agendalistentries}
    \ifdim\dimexpr\ht\hit@agendalistbox+\dp\hit@agendalistbox\relax
      >\dimexpr\textheight-1.2cm\relax
      \hit@scaleboxto{\hit@agendalistbox}{\dimexpr\textheight-1.2cm\relax}
    \fi
    \noindent\box\hit@agendalistbox
  }
\ExplSyntaxOff

% ------------------------------------------------------------- focus slide ----
\renewcommand{\hit@focuspage}[2]{%
  \setbeamercolor{background canvas}{bg=brand}%
  \begin{frame}[plain]
    \color{white}\vspace{6mm}
    {\fontsize{10}{14}\selectfont\bfseries #1\par}\vspace{7mm}
    {\fontsize{25}{34}\selectfont\bfseries #2\par}\vspace{6mm}
    {\color{cyan}\rule{3cm}{2pt}}
  \end{frame}}

% -------------------------------------------------------------- end slides ----
\renewcommand{\hit@endpage}[1]{%
  \begin{frame}[plain]
    \centering\includegraphics[width=4.4cm]{\hit@logo}\par\vspace{.9cm}
    {\color{brand}\fontsize{26}{34}\selectfont\bfseries #1\par}
    \vspace{.4cm}\usebeamertemplate*{hit end slot}
  \end{frame}}

% ---------------------------------------------------------------- appendix ----
% 附录里把顶部章节导航换成 APPENDIX 标记。
\apptocmd{\appendix}{\renewcommand{\hit@nav}{\hfill\color{muted}APPENDIX\hspace{.4cm}}}{}{}

\mode<all>
\endinput
