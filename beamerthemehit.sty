        {\includegraphics[width=\paperwidth]{\hitvipath hit-vi-mainbuilding-outline}};
      \hit@navinbg
    \end{tikzpicture}}}
\renewcommand{\hit@endpage}[1]{%
  \begin{frame}[t,plain,noframenumbering]
