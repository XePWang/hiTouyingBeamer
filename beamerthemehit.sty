% ----------------------------------------------------------------- appendix ----
% 进入附录则隐藏页脚上的文字，同时把正文部分的总页数写进 aux 文件，
% 这样页码的分母不会把附录算进去。
% 开了 navsymbols 时页脚仍然画出来，只是不写文字，让按钮停在与正文页相同的位置。
\apptocmd{\appendix}{%
  \immediate\write\@auxout{\string\gdef\string\hit@maintotal{\the\c@framenumber}}%
  % 附录里不画导航条，但要留出它原来占的高度，好让帧标题和正文页停在同一位置。
  % 高度直接用正文页那组固定值（\appendix 会另起一个 part，此时 \insertnavigation
  % 是空的，现量量不到）；末尾那段按字号补偿的间距也要照抄，否则横线会上移。
  \setbeamertemplate{headline}{%
    \vskip1.2mm%
    \begin{beamercolorbox}[wd=\paperwidth]{section in head/foot}%
      \usebeamerfont{section in head/foot}%
      \hbox{\vrule width\z@ height\hit@navht depth\hit@navdp}%
    \end{beamercolorbox}%
    {\usebeamerfont{section in head/foot}\vskip\dimexpr.3em+1.2mm\relax}%
  }%
}{}{}

