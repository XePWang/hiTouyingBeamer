%%
%% 更新记录
%%   v2.3      2026/10/02  接入公共内容层；封面显示标准 subtitle、英文标题与补充信息；
%%                        支持 \hitlogo 与目录显式 title；章节过渡页改用统一开关；
%%                        目录版块版式由公共渲染器绘制。
%%   v2.2      2026/10/01  接入公共命令层，本文件只保留经典样式。
%%   v1.2026b  2026/09/02  修正校训图与天际线图随标题行数浮动的问题。
%%   v1.2026a  2026/08/31  首次发布。
%%
%% Usage:
%%   \documentclass[aspectratio=169]{ctexbeamer}
%%   \usetheme{hit}
%%
%% Options:
%%   serif         - 用衬线字体；不写则用非衬线
%%   sans          - 用非衬线字体
%%   top           - 正文顶部对齐；不写则跟正文垂直居中
%%   navsymbols    - 显示右下角的翻页按钮；不写则隐藏
%%   nosectionpage - 不在每个 \section 处自动插入章节过渡页

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehit}[2026/10/02 v2.3 HIT beamer theme]

\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{etoolbox}

\mode<presentation>

% ---------------------------------------------------------------- options ----
% 章节过渡页与目录子章节用公共层的统一开关，两种主题都认。
\DeclareOptionBeamer{sectionpage}{\hitsectionpages}
\DeclareOptionBeamer{nosectionpage}{\hitnosectionpages}
% serif: 用衬线字体；默认用非衬线字体。
\newif\ifhit@serif \hit@seriffalse
\DeclareOptionBeamer{serif}{\hit@seriftrue}
\DeclareOptionBeamer{sans}{\hit@seriffalse}
% top: 正文顶部对齐；默认正文垂直居中。
\newif\ifhit@top \hit@topfalse
\DeclareOptionBeamer{top}{\hit@toptrue}
% navsymbols: 显示 beamer 右下角那组翻页按钮；默认隐藏。
\newif\ifhit@navsymbols \hit@navsymbolsfalse
\DeclareOptionBeamer{navsymbols}{\hit@navsymbolstrue}
\ProcessOptionsBeamer

% 主题加载标记：公共命令据此选择主题实现，未置位时退回标准 Beamer 写法。
\def\hit@theme@loaded{}
\def\hit@theme@name{hit}
\RequirePackage{beamercmdhit}

% 经典主题的目录显示子章节，默认用经典列表版式。
\hitoutlinesubs
\hittocmode{list}

% ----------------------------------------------------------------- colors ----
% 主色取自校徽 vi/hit-vi-logo-horizontal.png 上的蓝色，实测色值为 #166183。
\definecolor{hitprimary}{HTML}{166183}
\definecolor{hitneutraldarkest}{HTML}{000000}
\definecolor{hitneutraldark}{HTML}{202020}
\definecolor{hitneutrallight}{HTML}{F3F3F3}
\definecolor{hitneutrallightest}{HTML}{FFFFFF}

\setbeamercolor{normal text}{fg=hitneutraldarkest,bg=hitneutrallightest}
\setbeamercolor{structure}{fg=hitprimary}
\setbeamercolor{alerted text}{fg=hitprimary}
\setbeamerfont{alerted text}{series=\bfseries}
\setbeamercolor{frametitle}{fg=hitprimary,bg=}
\setbeamercolor{framesubtitle}{fg=hitprimary}
\setbeamercolor{title}{fg=hitprimary}
\setbeamercolor{subtitle}{fg=hitprimary}
\setbeamercolor{author}{fg=hitneutraldark}
\setbeamercolor{institute}{fg=hitneutraldark}
\setbeamercolor{date}{fg=hitneutraldark}
\setbeamercolor{section in head/foot}{fg=hitprimary}
\setbeamercolor{subsection in head/foot}{fg=hitprimary}
\setbeamercolor{mini frame}{fg=hitprimary}
\setbeamercolor{section in toc}{fg=hitneutraldarkest}
\setbeamercolor{subsection in toc}{fg=hitneutraldarkest}
% 页脚：左边的文字淡 40%，右边的页码淡 20%。
\setbeamercolor{footline left}{fg=hitneutraldarkest!60!white}
\setbeamercolor{footline right}{fg=hitneutraldarkest!80!white}
\setbeamercolor{block title}{fg=hitprimary,bg=hitneutrallight}
\setbeamercolor{block body}{fg=hitneutraldarkest,bg=hitneutrallight!60!white}
\setbeamercolor{block title example}{fg=hitprimary,bg=hitneutrallight}
\setbeamercolor{block body example}{fg=hitneutraldarkest,bg=hitneutrallight!60!white}
\setbeamercolor{block title alerted}{fg=hitneutrallightest,bg=hitprimary}
\setbeamercolor{block body alerted}{fg=hitneutraldarkest,bg=hitneutrallight!60!white}
\setbeamercolor{bibliography item}{fg=hitneutraldarkest}
\setbeamercolor{bibliography entry author}{fg=hitneutraldarkest}
\setbeamercolor{bibliography entry title}{fg=hitneutraldarkest}
\setbeamercolor{bibliography entry location}{fg=hitneutraldarkest}
\setbeamercolor{bibliography entry note}{fg=hitneutraldarkest}

% 公共内容组件在本主题下的配色。
\setbeamercolor{hit content muted}{fg=hitneutraldarkest!70}
\setbeamercolor{hit insight}{fg=hitneutraldarkest,bg=hitneutrallight!60!white}
\setbeamercolor{hit note rule}{fg=hitprimary}
\setbeamercolor{hit metric value}{fg=hitprimary}
\setbeamercolor{hit outline entry}{fg=hitprimary}
\setbeamercolor{hit agenda list number}{fg=hitneutraldarkest!45}
\setbeamercolor{hit outline rule}{fg=hitprimary}
\setbeamercolor{hit block capsule}{fg=white,bg=hitprimary}

% ------------------------------------------------------------------ fonts ----
\ifhit@serif
  \usefonttheme{serif}
\fi
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\small,series=\mdseries}
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\large,series=\bfseries}
\setbeamerfont{author}{size=\normalsize,series=\mdseries}
\setbeamerfont{date}{size=\normalsize}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{section in head/foot}{size=\tiny}
\setbeamerfont{footline}{size=\tiny}
\setbeamerfont{section in toc}{size=\normalsize}
\setbeamerfont{subsection in toc}{size=\small}
\setbeamerfont{section title}{size=\huge,series=\bfseries}
\setbeamerfont{hit outline title}{size=\LARGE,series=\bfseries}
\setbeamerfont{hit outline entry}{size=\normalsize,series=\mdseries}
\setbeamerfont{hit agenda list number}{size=\fontsize{13}{16},series=\bfseries}
% 蓝色标题页的字体。这里用 \Large 这类相对字号，文档基础字号在 8pt 到 20pt 之间改时会跟着变。
\setbeamerfont{hit blue title}{size=\Large,series=\bfseries}
\setbeamerfont{hit blue subtitle}{size=\normalsize,series=\bfseries}
\setbeamerfont{hit blue text}{size=\normalsize,series=\bfseries}
\setbeamerfont{hit blue institute}{size=\small,series=\bfseries}
% ------------------------------------------------------------ layout misc ----
% 让顶部导航的圆点挤在一行，效果同文档类选项 compress。
\beamer@compresstrue
\ifhit@top\beamer@centeredfalse\fi
% beamer 把翻页按钮塞进 LaTeX 的页脚，plain 帧上照画，位置和我们的页脚对不齐。
\setbeamertemplate{navigation symbols}{}
\renewcommand{\hit@navsyms}{%
  \usebeamercolor[fg]{navigation symbols}%
  \hbox{\insertslidenavigationsymbol\insertframenavigationsymbol
        \insertsubsectionnavigationsymbol\insertsectionnavigationsymbol
        \insertdocnavigationsymbol\insertbackfindforwardnavigationsymbol}}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{frametitle continuation}{}
\setbeamertemplate{section in head/foot shaded}[default][40]
\setbeamertemplate{subsection in head/foot shaded}[default][40]
\setbeamertemplate{mini frame in other subsection}[default][100]
\setbeamertemplate{mini frame in other section}[default][40]
% 不在任何小节里的帧，比如章节过渡页，不画圆点。
\let\hit@slideentry@orig\slideentry
\def\slideentry#1#2#3#4#5#6{%
  \ifnum#2>0 \hit@slideentry@orig{#1}{#2}{#3}{#4}{#5}{#6}\fi\ignorespaces}
\setbeamersize{text margin left=.7cm,text margin right=.7cm}
\setbeamersize{mini frame size=.09cm,mini frame offset=.03cm}

% 正文区域与 Academic 主题对齐，同一份内容在两种主题下都有同样的可用宽度。
% 经典主题的正文垂直居中由 beamer 负责，字号保持文档类的设置。
\setbeamertemplate{section in toc}{%
  {\usebeamerfont{section in toc}\hit@tocsechook\raggedright\inserttocsection\par}\vskip.9ex}
\setbeamertemplate{subsection in toc}{%
  {\usebeamerfont{subsection in toc}\hit@tocsubhook\raggedright
   \leftskip1.2em\inserttocsubsection\par}\vskip.7ex}

% ---------------------------------------------------------------- headline ----
% 顶部导航条：一行章节名，每帧一个圆点，当前章节高亮，其余淡化。
\newdimen\hit@navnat
\newif\ifhit@navmeasured
\newcommand{\hit@measurenav}{%
  \begingroup
  \global\hit@navnat=\z@
  \setbeamertemplate{section in toc}{%
    \setbox\@tempboxa=\hbox{{\usebeamerfont{section in head/foot}\inserttocsection}}%
    \global\advance\hit@navnat by\wd\@tempboxa
    \global\advance\hit@navnat by.6cm}%
  \setbeamertemplate{subsection in toc}{}%
  \setbox\z@=\vbox{\hsize=\textwidth\tableofcontents[sectionstyle=show,subsectionstyle=hide]}%
  \endgroup
  \@tempcnta=\inserttotalframenumber\relax
  \@tempdimb=\beamer@boxsize\relax
  \multiply\@tempdimb\@tempcnta
  \global\advance\hit@navnat by\@tempdimb
  \global\advance\hit@navnat by1.2cm}

% 导航条盒子的固定高与深，附录页的占位也用同一组值。
\newdimen\hit@navht
\newdimen\hit@navdp
\AtBeginDocument{{\usebeamerfont{section in head/foot}%
  \global\hit@navht=2.1ex
  \global\hit@navdp=\dimexpr\beamer@vboxoffset+\beamer@boxsize+.05cm\relax}}

\defbeamertemplate*{headline}{hit}{%
  \vskip1.2mm%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=.7cm,rightskip=.7cm]{section in head/foot}%
    \usebeamerfont{section in head/foot}%
    \ifhit@navmeasured\else\hit@measurenav\global\hit@navmeasuredtrue\fi
    \ifdim\hit@navnat>\dimexpr\paperwidth-1.4cm\relax
      \setbox\@tempboxa=\hbox{%
        \resizebox{\dimexpr\paperwidth-1.4cm\relax}{!}{\hbox{\insertnavigation{\hit@navnat}}}}%
    \else
      \setbox\@tempboxa=\hbox{\insertnavigation{\dimexpr\paperwidth-1.4cm\relax}}%
    \fi
    % 盒子高度取决于这一行里最高的字形，逐页会差一点，横线跟着抖。
    % 这里把高和深都钉死，正文页、附录页的横线才始终在同一位置。
    \ht\@tempboxa=\hit@navht \dp\@tempboxa=\hit@navdp
    \box\@tempboxa
  \end{beamercolorbox}%
  % 中文字形和圆点会伸到 beamer 给这行定的高度之外，按字号补一点间距。
  {\usebeamerfont{section in head/foot}\vskip\dimexpr.15em+.6mm\relax}%
}

% -------------------------------------------------------------- frametitle ----
% 标题行：粗体标题配右边的校训图，下面一条主色横线。
% 标题超过约 2.5 行就把字号往下调一档，\large -> \normalsize -> \small；换行时左对齐。
\newbox\hit@fttlbox
\newcommand{\hit@ft@try}[1]{%
  \setbox\hit@fttlbox=\hbox{%
    \begin{minipage}[b]{\dimexpr\textwidth-2.7cm\relax}%
      \usebeamerfont{frametitle}#1\raggedright
      \rule{0pt}{\hit@ftminheight}%
      \vphantom{汉Ag}\insertframetitle%
      \ifdefempty{\insertframesubtitle}{}{%
        \\[.2ex]{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}}%
    \end{minipage}}%
  \begingroup\usebeamerfont{frametitle}#1%
    \xdef\hit@ft@cap{\the\dimexpr2.6\baselineskip\relax}%
  \endgroup}

\newcommand{\hit@ftminheight}{6.2mm}
\newcommand{\hit@ftmottoraise}{.6mm}

\defbeamertemplate*{frametitle}{hit}{%
  \nointerlineskip
  \vskip.8mm%
  \hit@ft@try{}%
  \ifdim\dimexpr\ht\hit@fttlbox+\dp\hit@fttlbox\relax>\hit@ft@cap\relax
    \hit@ft@try{\normalsize}%
  \fi
  \ifdim\dimexpr\ht\hit@fttlbox+\dp\hit@fttlbox\relax>\hit@ft@cap\relax
    \hit@ft@try{\small}%
  \fi
  \begin{beamercolorbox}[wd=\textwidth]{frametitle}%
    \box\hit@fttlbox\par
  \end{beamercolorbox}%
  \vskip1.0mm%
  % 校训图改成零高零深的盒子贴着横线放，图与横线的间距恒定。
  \nointerlineskip
  \hbox to \textwidth{\hfill
    \raisebox{\hit@ftmottoraise}[0pt][0pt]{%
      \includegraphics[width=2.4cm]{\hit@vipath hit-vi-motto}}}%
  \nointerlineskip
  {\color{hitprimary}\hrule height .8pt}%
  \vskip1.0mm%
}

% ---------------------------------------------------------------- footline ----
% 页脚左边默认显示 \institute 的短名，改它用 \hitfooter。
\newcommand{\hit@footerleft}{\hit@footertext}

\newbox\hit@footbox

% 进入 \appendix 则隐藏页脚上的文字，同时把正文部分的总页数写进 aux 文件，
% 这样页码的分母不会把附录算进去。
\newcommand{\hit@drawfootline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.4ex,dp=1.8ex,leftskip=.7cm,rightskip=.7cm]{footline}%
    \setbox\@tempboxa=\hbox{\ifhit@appendix\else
      \usebeamerfont{footline}\usebeamercolor[fg]{footline left}\hit@footerleft\fi}%
    \setbox\hit@footbox=\hbox{\hit@footright{\hit@framenumber}}%
    \@tempdima=\dimexpr\paperwidth-1.4cm-\wd\hit@footbox-.5cm\relax
    \ifdim\wd\@tempboxa>\@tempdima
      \setbox\@tempboxa=\hbox{\resizebox{\@tempdima}{!}{\box\@tempboxa}}%
    \fi
    \box\@tempboxa\hfill\box\hit@footbox
  \end{beamercolorbox}}

\defbeamertemplate*{footline}{hit}{%
  \ifhit@appendix
    \ifhit@navsymbols\hit@drawfootline\fi
  \else
    \hit@drawfootline
  \fi
}

% --------------------------------------------------------------- title page ----
% 底图的主楼在右下方，左上角是空的，所以标题和信息都靠左上排。
% 左侧可用宽度随高度收窄，因此标题块比信息块宽，且都留出余量。
% 两块分开量高度，太高就往下调字号，调到最小还是太高就整体缩小。
\newbox\hit@tpboxa
\newbox\hit@tpboxb
\newcommand{\hit@tpindent}{.25cm}
\newcommand{\hit@tprulesep}{.045\paperheight}

% 标准 subtitle、英文标题与补充信息都排进标题块与信息块，不丢字段。
\newcommand{\hit@tp@try}[4]{%
  \setbox\hit@tpboxa=\hbox{%
    \begin{minipage}{.44\paperwidth}\raggedright
      {\usebeamerfont{title}#1\usebeamercolor[fg]{title}\inserttitle\par}%
      \hit@ifsubtitle{%
        \vskip1.6ex
        {\usebeamerfont{subtitle}#2\usebeamercolor[fg]{subtitle}\insertsubtitle\par}}{}%
      \hit@ifenglish{%
        \vskip1.2ex
        {\usebeamerfont{author}#3\usebeamercolor[fg]{author}\hit@english\par}}{}%
    \end{minipage}}%
  \setbox\hit@tpboxb=\hbox{%
    \begin{minipage}{.38\paperwidth}\raggedright
      \hit@ifsource{%
        {\usebeamerfont{author}#3\usebeamercolor[fg]{author}\hit@source\par}%
        \vskip2.2ex}{}%
      {\usebeamerfont{author}#3\usebeamercolor[fg]{author}\insertauthor\par}%
      \vskip2.2ex
      {\usebeamerfont{date}#3\usebeamercolor[fg]{date}\insertdate\par}%
      \vskip1.6ex
      {\usebeamerfont{institute}#4\usebeamercolor[fg]{institute}\insertinstitute\par}%
    \end{minipage}}}

\defbeamertemplate*{title page}{hit}{%
  \hit@tp@try{}{}{}{}%
  \@tempswafalse
  \ifdim\dimexpr\ht\hit@tpboxa+\dp\hit@tpboxa\relax>.34\paperheight\@tempswatrue\fi
  \ifdim\dimexpr\ht\hit@tpboxb+\dp\hit@tpboxb\relax>.26\paperheight\@tempswatrue\fi
  \if@tempswa\hit@tp@try{\Large}{\normalsize}{\small}{\footnotesize}\fi
  \@tempswafalse
  \ifdim\dimexpr\ht\hit@tpboxa+\dp\hit@tpboxa\relax>.34\paperheight\@tempswatrue\fi
  \ifdim\dimexpr\ht\hit@tpboxb+\dp\hit@tpboxb\relax>.26\paperheight\@tempswatrue\fi
  \if@tempswa\hit@tp@try{\large}{\small}{\footnotesize}{\scriptsize}\fi
  \ifdim\dimexpr\ht\hit@tpboxa+\dp\hit@tpboxa\relax>.34\paperheight
    \hit@scaleboxto\hit@tpboxa{.34\paperheight}\fi
  \ifdim\dimexpr\ht\hit@tpboxb+\dp\hit@tpboxb\relax>.26\paperheight
    \hit@scaleboxto\hit@tpboxb{.26\paperheight}\fi
  % 标题块从 12% 页高处起排，紧跟一道主色短线当下划线。
  \vspace*{.12\paperheight}%
  \noindent\hspace*{\hit@tpindent}\box\hit@tpboxa\par
  \vspace*{\hit@tprulesep}%
  \noindent\hspace*{\hit@tpindent}{\color{hitprimary}\rule{2.4cm}{1.2pt}}\par
  \vspace*{\hit@tprulesep}%
  \noindent\hspace*{\hit@tpindent}\box\hit@tpboxb\par
}

% ==================================================== 公共命令的主题实现 ====
\setbeamertemplate{hit end slot}{{\color{hitneutraldarkest!70}\insertshorttitle\par}}

% --------------------------------------------------------------- title page ----
\renewcommand{\hit@whitebackground}{%
  \setbeamertemplate{background}{%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      \node[anchor=south west,inner sep=0] at (0,0)
        {\includegraphics[width=\paperwidth]{\hit@vipath hit-vi-mainbuilding-outline}};
      \node[anchor=north east,inner sep=0]
        at ($(\paperwidth,\paperheight)+(-.35cm,-.3cm)$)
        {\includegraphics[height=.95cm]{\hit@vipath hit-vi-logo-horizontal}};
      \hit@navinbg
    \end{tikzpicture}}}
\renewcommand{\hit@titleslidepage}{\titlepage}

% 蓝色标题页：上半是校园照片，下半是主色色块。
\newbox\hit@bluebox
\newbox\hit@blueauthbox
\newdimen\hit@bluehgt
\newdimen\hit@blueT
\newdimen\hit@bluelogoy
\newdimen\hit@photoy
\newcommand{\hit@photoraisewide}{.058\paperwidth}
\newcommand{\hit@photoraisenarrow}{0pt}

\newcommand{\hit@bt@try}[3]{%
  \setbox\hit@blueauthbox=\hbox{%
    \begin{minipage}{.58\paperwidth}%
      \color{hitneutrallightest}\raggedright
      {\usebeamerfont{hit blue text}#2\insertauthor\par}%
      \vskip1.6mm
      {\usebeamerfont{hit blue text}#2\insertdate\par}%
      \vskip1.6mm
      {\usebeamerfont{hit blue institute}#3\insertinstitute\par}%
    \end{minipage}}%
  \setbox\hit@bluebox=\hbox{%
    \begin{minipage}{\dimexpr\paperwidth-2.2cm\relax}
      \color{hitneutrallightest}\raggedright
      {\usebeamerfont{hit blue title}#1\inserttitle\par}%
      \hit@ifsubtitle{%
        \vskip1.8mm{\usebeamerfont{hit blue subtitle}#2\insertsubtitle\par}}{}%
      \hit@ifenglish{%
        \vskip1.8mm{\usebeamerfont{hit blue text}#2\hit@english\par}}{}%
      \hit@ifsource{%
        \vskip1.8mm{\usebeamerfont{hit blue text}#3\hit@source\par}}{}%
      \vskip5mm
      \noindent\copy\hit@blueauthbox\par
    \end{minipage}}}

\renewcommand{\hit@bluebackground}{%
  \setbeamertemplate{background}{%
    \hit@bt@try{}{}{}%
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@bt@try{\large}{\small}{\footnotesize}%
    \fi
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@bt@try{\normalsize}{\footnotesize}{\scriptsize}%
    \fi
    \hit@blueT=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox\relax
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@scaleboxto\hit@bluebox{.60\paperheight-1.25cm}%
    \fi
    \hit@bluehgt=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax
    \ifdim\hit@bluehgt<.545\paperheight\hit@bluehgt=.545\paperheight\fi
    \@tempdima=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox\relax
    \@tempdimb=\dimexpr\ht\hit@blueauthbox+\dp\hit@blueauthbox\relax
    \pgfmathsetlength\hit@bluelogoy{%
      .5\hit@bluehgt-.5\@tempdima+.5\@tempdimb/\hit@blueT*\@tempdima}%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      % 两种画幅露出的照片高度不同，因此取景位置不同：16:9 往上放一点，4:3 对齐页顶。
      \ifdim\paperheight<.6\paperwidth
        \hit@photoy=\dimexpr\paperheight+\hit@photoraisewide\relax
      \else
        \hit@photoy=\dimexpr\paperheight+\hit@photoraisenarrow\relax
      \fi
      \node[anchor=north west,inner sep=0] at (0,\hit@photoy)
        {\includegraphics[width=\paperwidth]{\hit@vipath hit-vi-mainbuilding-photo}};
      \fill[hitprimary] (0,0) rectangle (\paperwidth,\hit@bluehgt);
      \draw[hitneutrallight,line width=.8pt]
        (0,\hit@bluehgt) -- (\paperwidth,\hit@bluehgt);
      \node[anchor=east,inner sep=0]
