%% Font files and their licenses are listed in fonts/README.md.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hit-fonts}[2026/09/27 bundled OFL fonts]
\RequirePackage{fontspec}
\setmainfont{SourceSans3}[Path=fonts/source-sans/,Extension=.ttf,
  UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-It,BoldItalicFont=*-BoldIt]
\setsansfont{SourceSans3}[Path=fonts/source-sans/,Extension=.ttf,
  UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-It,BoldItalicFont=*-BoldIt]
\setmonofont{JetBrainsMono}[Path=fonts/jetbrains-mono/,Extension=.ttf,
  UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Italic,BoldItalicFont=*-BoldItalic,
  Ligatures=NoCommon]
\setCJKmainfont{SourceHanSansCN}[Path=fonts/source-han-sans/,Extension=.otf,
  UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,BoldItalicFont=*-Bold]
\setCJKsansfont{SourceHanSansCN}[Path=fonts/source-han-sans/,Extension=.otf,
  UprightFont=*-Regular,BoldFont=*-Bold,ItalicFont=*-Regular,BoldItalicFont=*-Bold]
\setCJKmonofont{SourceHanSansCN}[Path=fonts/source-han-sans/,Extension=.otf,
  UprightFont=*-Regular,BoldFont=*-Bold]
