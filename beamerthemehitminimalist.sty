%%
%% 本文件只负责视觉：蓝色标题栏、浅灰画布、顶部章节导航、双语封面、目录版块版式。
%% 公共命令、内容组件与目录数据由 beamercmdhit.sty、hit-content.sty、hit-outline.sty
%% 提供，各主题共用同一份实现。
%%
%% 更新记录
%%   v2.2026a 2026/10/09  主题正式迁移为 Minimalist（原 Academic 风格）；
%%                         适配 v2 共享架构与跨主题接口。
%%   v2.3     2026/10/02  接入公共内容层；不再重定义内容组件，只配置颜色与字号；
%%                         目录版块版式改由公共渲染器排布条目。
%%   v2.2     2026/10/01  首次以独立主题形式提供 Academic 风格。
%%
%% Usage:
%%   \documentclass[aspectratio=169,11pt,fontset=none]{ctexbeamer}
%%   \usetheme[minimalist]{hit}
%%
%% 字体与素材：字体来自 hit-fonts.sty 加载的 fonts/ 目录；
%% 封面标识用 \hitlogo{文件路径}，插图目录用 \hitfigures{路径}。

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemehitminimalist}[2026/10/09 v2.2026a hiTouyingBeamer Minimalist]

\RequirePackage{iftex}
\RequireXeTeX

\mode<presentation>

% 主题加载标记与公共命令层。
\def\hit@theme@loaded{}
\def\hit@theme@name{hitminimalist}
\def\hit@theme@minimalist{}
\RequirePackage{beamercmdhit}

\RequirePackage{lmodern}
\IfFileExists{fonts/source-sans/SourceSans3-Regular.ttf}{\RequirePackage{hit-fonts}}{}
\usefonttheme{professionalfonts}
\RequirePackage{totcount}
\@ifundefined{c@hit@sectiontotal}{\newcounter{hit@sectiontotal}\regtotcounter{hit@sectiontotal}}{}

% Minimalist 主题不插入章节过渡页，目录不显示子章节。
\hitnosectionpages
\hitnooutlinesubs
\hittocmode{block}

% 表格与代码排版设置（仅 minimalist 主题生效）
\renewcommand{\arraystretch}{1.08}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\setlength{\tabcolsep}{4.5pt}
\lstset{
  language=C++,
  basicstyle=\ttfamily\fontsize{7.3}{10}\selectfont,
  keywordstyle=\color{structure.fg}\bfseries,
  commentstyle=\color{normal text.fg!60},
  stringstyle=\color{structure.fg!80!black},
  showstringspaces=false,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  backgroundcolor=\color{structure.fg!8},
  frame=none,
  aboveskip=5pt,
  belowskip=5pt,
  xleftmargin=5pt,
  xrightmargin=5pt,
  rulecolor=\color{normal text.fg!20}
}

% ----------------------------------------------------------------- colors ----
\definecolor{brand}{HTML}{0070BE}
\definecolor{cyan}{HTML}{00A3D9}
\definecolor{ink}{HTML}{263B4D}
\definecolor{muted}{HTML}{526779}
\definecolor{pale}{HTML}{EDF4FA}
\definecolor{canvas}{HTML}{F7F9FB}
\definecolor{linegray}{HTML}{D5E0E8}
\definecolor{risk}{HTML}{BD5A32}
\definecolor{good}{HTML}{287763}

\colorlet{hitprimary}{brand}
\colorlet{hitneutraldarkest}{ink}
\colorlet{hitneutrallightest}{pale}
\colorlet{hitneutrallight}{linegray}

\setbeamercolor{normal text}{fg=ink,bg=canvas}
\setbeamercolor{background canvas}{bg=canvas}
\setbeamercolor{frametitle}{fg=white,bg=brand}
\setbeamercolor{itemize item}{fg=brand}
\setbeamercolor{alerted text}{fg=risk}
\setbeamercolor{structure}{fg=brand}
\setbeamercolor{palette primary}{fg=white,bg=brand}
\setbeamercolor{block title}{fg=brand,bg=pale}
\setbeamercolor{block body}{fg=ink,bg=pale}
% 公共内容组件在本主题下的配色。
\setbeamercolor{hit content muted}{fg=muted}
\setbeamercolor{hit insight}{fg=ink,bg=pale}
\setbeamercolor{hit note rule}{fg=risk}
\setbeamercolor{hit metric value}{fg=brand}
\setbeamercolor{hit outline entry}{fg=brand}
\setbeamercolor{hit agenda list number}{fg=brand}
\setbeamercolor{hit outline rule}{fg=linegray}
\setbeamercolor{hit block capsule}{fg=white,bg=brand}

% ------------------------------------------------------------------ fonts ----
% size 里只写 \fontsize，不写 \selectfont：beamer 取用 size 时会当场求值，
% 带上 \selectfont 会把当前行的基线间距也改掉，正文行高随之变大。
\setbeamerfont{normal text}{size=\fontsize{9.5}{13}}
\setbeamerfont{frametitle}{size=\fontsize{15}{19},series=\bfseries}
\setbeamerfont{hit outline title}{size=\fontsize{20}{24},series=\bfseries}
\setbeamerfont{hit outline entry}{size=\fontsize{11.5}{14},series=\bfseries}
\setbeamerfont{hit agenda list number}{size=\fontsize{13}{16},series=\bfseries}
\setbeamerfont{hit content subhead}{size=\fontsize{9.5}{13},series=\bfseries}
\setbeamerfont{hit content caption}{size=\fontsize{7.7}{10},series=\mdseries}
\setbeamerfont{hit content insight}{size=\fontsize{9}{12},series=\mdseries}
\setbeamerfont{hit content note}{size=\fontsize{8}{11},series=\mdseries}
\setbeamerfont{hit content metric}{size=\fontsize{24}{28},series=\bfseries}
\setbeamerfont{hit content metric note}{size=\fontsize{8.3}{11},series=\mdseries}

% 正文区域与经典主题对齐：同一份内容在两种主题下都有同样的可用宽度。
\setbeamersize{text margin left=.7cm,text margin right=.7cm}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{background}{}
\setbeamertemplate{section in head/foot}{\colorbox{brand}{\strut\color{white}\bfseries\insertsectionhead}}
\setbeamertemplate{section in head/foot shaded}{\colorbox{canvas}{\strut\color{muted}\insertsectionhead}}
\setbeamertemplate{itemize items}{\raisebox{.15ex}{\tiny\color{brand}$\bullet$}}
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{section in toc}{%
  \color{brand}\inserttocsectionnumber\quad\color{ink}\inserttocsection\par\vspace{3mm}}
\lstset{language=C++,basicstyle=\ttfamily\fontsize{7.3}{10}\selectfont,
  keywordstyle=\color{brand}\bfseries,commentstyle=\color{muted},stringstyle=\color{good},
  showstringspaces=false,breaklines=true,columns=fullflexible,keepspaces=true,
  backgroundcolor=\color{pale},frame=none,aboveskip=5pt,belowskip=5pt,
  xleftmargin=5pt,xrightmargin=5pt,rulecolor=\color{linegray}}
\renewcommand{\arraystretch}{1.18}
\renewcommand{\tabularxcolumn}[1]{>{\raggedright\arraybackslash}p{#1}}
\setlength{\tabcolsep}{5pt}
\AtBeginEnvironment{frame}{\bodytext}
\AtBeginDocument{\renewcommand{\normalsize}{\fontsize{9.5}{13}\selectfont}\normalsize}
% ---------------------------------------------------------------- headline ----
% 固定页眉高度；章节名称由正文自动生成，当前章节显示蓝色背景。
% 导航盒子的测量与输出在同一分组内完成，保留局部赋值。
\newdimen\hit@navavail
\newsavebox\hit@navbox
\newsavebox\hit@headbox
\newcommand{\hit@navavailwd}{\dimexpr\paperwidth-3.0cm-1.4cm\relax}
% 测量副本按自然宽度装箱，保留 Beamer 的章节筛选与跳转实现。
\let\hit@navnatural\insertsectionnavigationhorizontal
\patchcmd{\hit@navnatural}{\hbox to #1}{\hbox}{}{%
  \PackageError{beamerthemehitminimalist}{Cannot measure section navigation}%
    {The Beamer section navigation implementation has changed.}}
\newcommand{\hit@nav}{%
  \insertsectionnavigationhorizontal{\hit@navavailwd}{}{\hfill}}
\newcommand{\hit@headnav}{%
  \begingroup
  \setbox\hit@navbox=\hbox{\fontsize{7.7}{10}\selectfont
    \let\insertsectionnavigationhorizontal\hit@navnatural
    \hit@nav}%
  \hit@navavail=\hit@navavailwd
  \ifdim\wd\hit@navbox>\hit@navavail
    \setbox\hit@navbox=\hbox{\resizebox{\hit@navavail}{!}{\box\hit@navbox}}%
  \else
    \setbox\hit@navbox=\hbox{\fontsize{7.7}{10}\selectfont\hit@nav}%
  \fi
  \hbox to\hit@navavail{\unhbox\hit@navbox\hfil}%
  \endgroup}
\setbeamertemplate{headline}{%
  \sbox\hit@headbox{\hbox{\hspace{.7cm}%
    \parbox[c][.67cm][c]{3.0cm}{\includegraphics[width=2.9cm]{\hit@logopath}}%
    \parbox[c][.67cm][c]{\hit@navavailwd}{\hit@headnav}}}%
  \hbox to \paperwidth{\hss\box\hit@headbox\hss}%
  \nointerlineskip{\color{linegray}\rule{\paperwidth}{.45pt}}}

% -------------------------------------------------------------- frametitle ----
\setbeamertemplate{frametitle}{%
  \vskip1.7mm
  \begin{beamercolorbox}[wd=\textwidth,sep=.20cm,leftskip=.03cm,rightskip=.03cm]{frametitle}
    \usebeamerfont{frametitle}\strut\insertframetitle\strut
  \end{beamercolorbox}\vskip1.2mm}

% ---------------------------------------------------------------- footline ----
\setbeamertemplate{footline}{%
  \hbox to\paperwidth{\hspace{.7cm}\color{muted}\fontsize{6.3}{8}\selectfont
    \hit@footertext\hfill\insertpagenumber\hspace{.7cm}}\vskip2.3mm}

% ==================================================== 公共命令的主题实现 ====
\setbeamertemplate{hit end slot}{{\color{muted}\insertshorttitle\par}}

% ------------------------------------------------------------- title page ----
\def\hit@titleslidepage{%
  \vspace{.1cm}
  \begin{center}\includegraphics[width=4.4cm]{\hit@logopath}\end{center}
  \vspace{.22cm}
  \begin{beamercolorbox}[wd=\textwidth,sep=.4cm,center]{palette primary}
    {\fontsize{23}{30}\selectfont\bfseries\inserttitle\par}
    \hit@ifsubtitle{%
      \vspace{.22cm}{\fontsize{11.5}{15}\selectfont\insertsubtitle\par}}{}%
    \hit@ifenglish{%
      \vspace{.38cm}{\fontsize{12.1}{16}\selectfont\hit@english\par}}{}%
  \end{beamercolorbox}
  \vspace{.22cm}
  \begin{center}\smalltext
    \hit@ifsource{\hit@source\par\vspace{.14cm}}{}%
    \insertauthor\par\smallskip
    \insertinstitute\par\smallskip\insertdate
  \end{center}}

% 蓝色照片封面与白色封面在本主题下使用同一套版式。
\def\hit@bluetitleslidepage{\hit@titleslidepage}

% ----------------------------------------------------------------- outline ----
% 版块版式：左侧标题色块与副标题，右侧圆角横条由公共渲染器统一排布。
\def\hit@outlineblockpaint{%
  \fill[canvas] (0,0) rectangle (\paperwidth,\paperheight);
  \fill[brand!40!white] (-.02\paperwidth,.255\paperheight) -- (.18\paperwidth,.255\paperheight)
    arc[start angle=-90,end angle=90,x radius=.15\paperwidth,y radius=.245\paperheight]
    -- (-.02\paperwidth,.745\paperheight) -- cycle;
  \fill[brand] (-.02\paperwidth,.27\paperheight) -- (.18\paperwidth,.27\paperheight)
    arc[start angle=-90,end angle=90,x radius=.137\paperwidth,y radius=.23\paperheight]
    -- (-.02\paperwidth,.73\paperheight) -- cycle;
  \node[text=white,align=center,text width=.28\paperwidth,
    font=\bfseries\fontsize{32}{36}\selectfont,inner sep=0pt]
    at (.157\paperwidth,.55\paperheight) {\hit@getoutlinetitle};
  \node[text=white,align=center,text width=.28\paperwidth,
    font=\bfseries\fontsize{10.5}{13}\selectfont,inner sep=0pt]
    at (.157\paperwidth,.415\paperheight) {\hit@getoutlinesubtitle};
}
\def\hit@drawlistheader#1{%
  {\usebeamerfont{hit outline title}\usebeamercolor[fg]{structure}%
   \hit@getoutlinetitle\ifnum#1>1\relax\space\mdseries\small（续）\fi\par}%
  \vskip2mm{\color{linegray}\rule{\textwidth}{.45pt}}%
  \vskip4mm}

% ------------------------------------------------------------- focus slide ----
\def\hit@focuspage#1#2{%
  \setbeamercolor{background canvas}{bg=brand}%
  \begin{frame}[plain]
    \color{white}\vspace{6mm}
    \hit@iffocuslabel{#1}{{\fontsize{10}{14}\selectfont\bfseries #1\par}\vspace{7mm}}{}%
    {\fontsize{25}{34}\selectfont\bfseries #2\par}\vspace{6mm}
    {\color{cyan}\rule{3cm}{2pt}}
  \end{frame}}

% -------------------------------------------------------------- end slides ----
\def\hit@endpage#1{%
  \begin{frame}[plain]
    \centering\includegraphics[width=4.4cm]{\hit@logopath}\par\vspace{.9cm}
    {\color{brand}\fontsize{26}{34}\selectfont\bfseries #1\par}
    \vspace{.4cm}\usebeamertemplate*{hit end slot}
  \end{frame}}

% ---------------------------------------------------------------- appendix ----
% 附录里把顶部章节导航换成 APPENDIX 标记。
\apptocmd{\appendix}{\renewcommand{\hit@nav}{\hfill\color{muted}APPENDIX\hspace{.4cm}}}{}{}

\mode<all>
\endinput
