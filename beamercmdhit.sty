%% 本文件放给文档用的命令与配套包：\TitleSlide 等整页命令、\upcite、\cmd、\env
%% 等辅助命令，以及 unicode-math、physics、listings 等配套包（原先在旧
%% HITBeamer 的 hit-extra.sty 里，现在所有主题共用）。样式在主题文件里。
%% 配 \usetheme{hit} 使用时，主题会自动加载本文件，命令走完整的定制版式；
%% 换成 Madrid 等内建主题时，同名命令改用标准 Beamer 写法，例如 \titlepage、
%% \tableofcontents，文档不必改动即可编译。
%%
%%
%% 更新记录
%%   v2.2026a  2026/10/09  加 classic 主题分支：\TitleSlide 等命令在经典主题下
%%                         按旧 HITBeamer 观感实现；旧 hit-extra 的配套包与
%%                         命令（unicode-math、physics、listings、\upcite、
%%                         \cmd、\env 等）移入本文件，所有主题共用；
%%                         图表标题编号（caption[numbered]）也在这里统一打开；
%%                         整合公共内容支持层（hit-content 与 hit-outline），
%%                         提供全主题共享的版式与内容组件命令。
%%   v1.2026b  2026/09/02  配合主题修正校训图定位，本文件无功能改动。
%%   v1.2026a  2026/08/16  首次发布。
%%
%% Usage:
%%   \usepackage{beamercmdhit}    % 写在 \usetheme 前后皆可

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercmdhit}[2026/10/09 v2.2026a document commands for the HIT beamer theme]

\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{etoolbox}

% -------------------------------------------------- 配套包（原 hit-extra） ----
% 这一组包原先在旧 HITBeamer 的 hit-extra.sty 里，现在放在共用命令层，
% 两套主题、乃至换成 Madrid 等内建主题时都能用。
\RequirePackage{ctex}
\RequirePackage{xeCJKfntef}
\RequirePackage{latexsym,amsmath,xcolor,multicol,booktabs,calligra}
\RequirePackage{graphicx,listings,stackengine}
\RequirePackage{physics}
\RequirePackage[bold-style=ISO]{unicode-math}

% 图表标题带编号（表 1、图 1……），各主题共用。
\setbeamertemplate{caption}[numbered]

% 基础色彩预置，保证未加载具体主题时也可用
\providecolor{hitprimary}{RGB}{22,97,131}
\providecolor{hitneutraldarkest}{RGB}{38,59,77}
\providecolor{hitneutrallightest}{RGB}{237,244,250}
\providecolor{hitneutrallight}{RGB}{213,224,232}

% 加载公共内容与目录模块
\RequirePackage{hit-content}
\RequirePackage{hit-outline}

% ==================================================== 目录数据的取值包装 ====
\ExplSyntaxOn
\cs_new:Npn \hit@getcount { \hit_outline_count: }
\cs_new:Npn \hit@gettitle #1 { \hit_outline_title:n {#1} }
\cs_new:Npn \hit@gettarget #1 { \hit_outline_target:n {#1} }
\cs_new:Npn \hit@getoutlinetitle { \hit_outline_title: }
\cs_new:Npn \hit@getoutlinesubtitle { \hit_outline_subtitle: }
\cs_new:Npn \hit@getsubcount { \hit_outline_subsec_count: }
\cs_new:Npn \hit@getsubitem #1 { \hit_outline_subsec_title:n {#1} }
\cs_new:Npn \hit@outlinelink #1 #2 { \hit_outline_link:nn {#1} {#2} }
\ExplSyntaxOff

% ============================================================ 内容字段 ====
\newcommand{\hit@english}{}
\newcommand{\englishtitle}[1]{\renewcommand{\hit@english}{#1}}
\newcommand{\hit@source}{}
\newcommand{\titlecontext}[1]{\renewcommand{\hit@source}{#1}}

\newcommand{\hit@ifenglish}[2]{\ifdefempty{\hit@english}{#2}{#1}}
\newcommand{\hit@ifsource}[2]{\ifdefempty{\hit@source}{#2}{#1}}
\newcommand{\hit@ifsubtitle}[2]{\ifdefempty{\insertsubtitle}{#2}{#1}}
\newcommand{\hit@iffocuslabel}[3]{%
  \if\relax\detokenize{#1}\relax
    #3%
  \else
    #2%
  \fi}

% -------------------------------------------------- 配套命令（原 hit-extra） ----
% biblatex-gb7714-2015 也定义 \upcite，它用 \newcommand，所以这里放到文档开始时
% 用 \providecommand 补一个缺省定义，谁先定义就听谁的。
\AtBeginDocument{\providecommand{\upcite}[1]{\textsuperscript{\cite{#1}}}}

\def\cmd#1{\texttt{\color{red}\fontsize{8}{9.6}\selectfont $\backslash$#1}}
\def\env#1{\texttt{\color{blue}\fontsize{8}{9.6}\selectfont #1}}
\definecolor{deepblue}{rgb}{0,0,0.5}
\definecolor{deepred}{rgb}{0.6,0,0}
\definecolor{deepgreen}{rgb}{0,0.5,0}
\definecolor{halfgray}{gray}{0.55}

\lstset{
    basicstyle=\ttfamily\fontsize{8}{9.6}\selectfont,
    keywordstyle=\bfseries\color{deepblue},
    emphstyle=\ttfamily\color{deepred},
    stringstyle=\color{deepgreen},
    numbers=left,
    numberstyle=\fontsize{7}{8.4}\selectfont\color{halfgray},
    rulesepcolor=\color{red!20!green!20!blue!20},
    frame=shadowbox,
}

% 页脚页码的分隔符；经典主题的页脚用它。
\newcommand{\frameofframes}{/}
\newcommand{\setframeofframes}[1]{\renewcommand{\frameofframes}{#1}}

% ------------------------------------------------------------ shared tools ----
% 当前主题的标题与作者，模板里写 \title{\themetitle}、\author{\themeauthor}。
% 各主题文件会覆盖成自己的；没加载 hit 主题时用下面这份缺省。
\newcommand{\themetitle}{哈尔滨工业大学 Beamer 幻灯片主题——\textsc{hiTouyingBeamer}}
\newcommand{\themeauthor}{SchrodingerBlume 和 syvshc}

% 页脚文字统一设置
\newcommand{\hit@footertext}{\insertshortinstitute}
\newcommand{\hitfooter}[1]{%
  \renewcommand{\hit@footertext}{#1}%
  \ifdefined\hit@footerleft\renewcommand{\hit@footerleft}{#1}\fi}

% 封面、结束页这些 plain 帧 Beamer 不画页脚，翻页按钮会跟着消失。
% 这里把按钮画进背景，坐标与页脚里的一致，翻页时按钮不会跳。
% 开关由主题声明；没加载主题时补一个假值，下面的判断才有东西可查。
\@ifundefined{ifhit@navsymbols}{\newif\ifhit@navsymbols}{}
\newcommand{\hit@navinbg}{%
  \ifhit@navsymbols
    % 背景按钮依赖现代主题页脚里的 \hit@footright/\hit@footbase；
    % 经典主题没有这两个（它的按钮是 beamer 自带的），跳过即可。
    \ifdefined\hit@footright
      \node[anchor=base east,inner sep=0]
        at (\the\dimexpr\paperwidth-.7cm\relax,\the\hit@footbase) {\hit@footright{}};
    \fi
  \fi}
% 深色底的页面上按钮要提亮，否则看不见。
\newcommand{\hit@navinbglight}{%
  \begingroup
  \setbeamercolor{navigation symbols}{fg=hitneutrallightest!60!hitprimary}%
  \hit@navinbg
  \endgroup}

% -------------------------------------------------------------- title page ----
% 白色标题页：右上角校徽，底部校园线稿背景。文字如何排列见主题的 title page 模板。
\newcommand{\TitleSlide}{%
  \ifdefined\hit@theme@loaded
    \hit@TitleSlide@pick
  \else
    \hit@TitleSlide@plain
  \fi}
\newcommand{\hit@TitleSlide@pick}{%
  \ifdefined\hit@theme@classic
    \let\hit@title@next\hit@TitleSlide@classic
  \else
    \ifdefined\hit@theme@academic
      \let\hit@title@next\hit@TitleSlide@academic
    \else
      \let\hit@title@next\hit@TitleSlide@themed
    \fi
  \fi
  \hit@title@next}
\newcommand{\hit@TitleSlide@plain}{%
  \begin{frame}[plain,noframenumbering]\titlepage\end{frame}}
\newcommand{\hit@TitleSlide@academic}{%
  \begingroup
  \stepcounter{hit@front}%
  \begin{frame}[t,plain,noframenumbering]
    \hit@titleslidepage
  \end{frame}
  \endgroup}
\newcommand{\hit@TitleSlide@themed}{%
  \begingroup
  \setbeamertemplate{background}{%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      \node[anchor=south west,inner sep=0] at (0,0)
        {\includegraphics[width=\paperwidth]{\hitvipath hit-vi-mainbuilding-outline}};
      \node[anchor=north east,inner sep=0]
        at ($(\paperwidth,\paperheight)+(-.35cm,-.3cm)$)
        {\includegraphics[height=.95cm]{\hitvipath hit-vi-logo-horizontal}};
      \hit@navinbg
    \end{tikzpicture}}%
  \stepcounter{hit@front}%
  % 标题页自行计算上下间距，这里固定顶部对齐，不受正文对齐选项影响。
  \begin{frame}[t,plain,noframenumbering]
    \titlepage
  \end{frame}
  \endgroup}

% 经典主题的标题页：classic 的 \titlepage（标题框是主色底白字），下方居中摆校徽。
\newcommand{\hit@TitleSlide@classic}{%
  \begin{frame}[plain,noframenumbering]
    \titlepage
    \begin{center}
      \includegraphics[width=.2\linewidth]{\hitvipath hit-vi-logo-horizontal}%
    \end{center}
  \end{frame}}

% 蓝色标题页：上半是校园照片，下半是主色色块。
% 色块高度随文字变化，但有上限和下限，文字在色块内垂直居中。
% 文字过多则先降字号，降到最小仍超出则整体缩小。
% 各主题下都长这样，所以这些字号也放在共用层。
\setbeamerfont{hit blue title}{size=\Large,series=\bfseries}
\setbeamerfont{hit blue subtitle}{size=\normalsize,series=\bfseries}
\setbeamerfont{hit blue text}{size=\normalsize,series=\bfseries}
\setbeamerfont{hit blue institute}{size=\small,series=\bfseries}
\newbox\hit@bluebox
\newbox\hit@blueauthbox
\newdimen\hit@bluehgt
\newdimen\hit@blueT
\newdimen\hit@bluelogoy

% 作者信息单独装一个盒子：一份排入文字块，另一份用于计算校徽的高度。
% 蓝色封面照片的取景高度：16:9 与 4:3 值不同，正值越大，照片越往上。
\newdimen\hit@photoy
\newcommand{\hit@photoraisewide}{.058\paperwidth}
\newcommand{\hit@photoraisenarrow}{0pt}

\newcommand{\hit@bt@try}[3]{%
  \setbox\hit@blueauthbox=\hbox{%
    \begin{minipage}{.58\paperwidth}%
      \color{hitneutrallightest}\raggedright
      {\usebeamerfont{hit blue text}#2\insertauthor\par}%
      \vskip1.6mm
      {\usebeamerfont{hit blue text}#2\insertdate\par}%
      \vskip1.6mm
      {\usebeamerfont{hit blue institute}#3\insertinstitute\par}%
    \end{minipage}}%
  \setbox\hit@bluebox=\hbox{%
    \begin{minipage}{\dimexpr\paperwidth-2.2cm\relax}
      \color{hitneutrallightest}\raggedright
      {\usebeamerfont{hit blue title}#1\inserttitle\par}%
      \ifdefempty{\insertsubtitle}{}{%
        \vskip1.8mm{\usebeamerfont{hit blue subtitle}#2\insertsubtitle\par}}%
      \vskip5mm
      \noindent\copy\hit@blueauthbox\par
    \end{minipage}}}

\newcommand{\BlueTitleSlide}{%
  \ifdefined\hit@theme@loaded
    \hit@BlueTitleSlide@themed
  \else
    \hit@TitleSlide@plain
  \fi}
\newcommand{\hit@BlueTitleSlide@themed}{%
  \begingroup
  \setbeamertemplate{background}{%
    \hit@bt@try{}{}{}%
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@bt@try{\large}{\small}{\footnotesize}%
    \fi
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@bt@try{\normalsize}{\footnotesize}{\scriptsize}%
    \fi
    \hit@blueT=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox\relax
    \ifdim\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax>.60\paperheight
      \hit@scaleboxto\hit@bluebox{.60\paperheight-1.25cm}%
    \fi
    \hit@bluehgt=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox+1.25cm\relax
    \ifdim\hit@bluehgt<.545\paperheight\hit@bluehgt=.545\paperheight\fi
    % 校徽的高度对准作者信息的中心。前面若整体缩小过，这里按缩放比例折算。
    \@tempdima=\dimexpr\ht\hit@bluebox+\dp\hit@bluebox\relax
    \@tempdimb=\dimexpr\ht\hit@blueauthbox+\dp\hit@blueauthbox\relax
    \pgfmathsetlength\hit@bluelogoy{%
      .5\hit@bluehgt-.5\@tempdima+.5\@tempdimb/\hit@blueT*\@tempdima}%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      \ifdim\paperheight<.6\paperwidth
        \hit@photoy=\dimexpr\paperheight+\hit@photoraisewide\relax
      \else
        \hit@photoy=\dimexpr\paperheight+\hit@photoraisenarrow\relax
      \fi
      \node[anchor=north west,inner sep=0] at (0,\hit@photoy)
        {\includegraphics[width=\paperwidth]{\hitvipath hit-vi-mainbuilding-photo}};
      \fill[hitprimary] (0,0) rectangle (\paperwidth,\hit@bluehgt);
      \draw[hitneutrallight,line width=.8pt]
        (0,\hit@bluehgt) -- (\paperwidth,\hit@bluehgt);
      \node[anchor=east,inner sep=0]
        at ($(\paperwidth,\hit@bluelogoy)+(-.95cm,0)$)
        {\includegraphics[width=.27\paperwidth]{\hitvipath hit-vi-logo-horizontal-white}};
      \node[anchor=west,inner sep=0] at (.95cm,.5\hit@bluehgt) {\box\hit@bluebox};
      \hit@navinbglight
    \end{tikzpicture}}%
  \stepcounter{hit@front}%
  \begin{frame}[plain,noframenumbering]
  \end{frame}
  \endgroup}

% ----------------------------------------------------------------- outline ----
\newcommand{\hitoutlinetitle}{目录}

% 目录页专用的条目样式：浅色大编号，主色粗体章节名，灰色 ○ 小节。
% 只在 \OutlineSlide 内生效，文档里自己写的 \tableofcontents 不受影响。
\newcommand{\hit@ol@settemplates}{%
  \setbeamertemplate{section in toc}{%
    \vskip1.2ex
    {\usebeamerfont{section in toc}\hit@tocsechook\bfseries\raggedright
     \hangindent2.6em\hangafter\@ne
     \leavevmode\hbox to 2.6em{{\color{hitprimary!45}\large
       \two@digits{\inserttocsectionnumber}}\hfil}%
     {\color{hitprimary}\inserttocsection}\par}%
    \nopagebreak\vskip.7ex}%
  \setbeamertemplate{subsection in toc}{%
    {\usebeamerfont{subsection in toc}\hit@tocsubhook\raggedright
     \leftskip2.6em\color{hitneutraldarkest!70}%
     \raisebox{.18ex}{\scriptsize$\circ$}\hspace{.5em}\inserttocsubsection\par}\vskip.5ex}}


\newbox\hit@outbox
\newdimen\hit@secavail

\newcommand{\hit@outlinetoc}{%
  \@ifundefined{c@hit@sectiontotal@totc}{\@tempcnta=0\relax}{\@tempcnta=\totvalue{hit@sectiontotal}\relax}%
  \@tempcntb=\@tempcnta\advance\@tempcntb\@ne\divide\@tempcntb\tw@
  \edef\hit@ol@callA{\noexpand\tableofcontents[sections={1-\the\@tempcntb}]}%
  \edef\hit@ol@callB{\noexpand\tableofcontents[sections={\the\numexpr\@tempcntb+1\relax-\the\@tempcnta}]}%
  \def\hit@ol@try##1##2{%
    \def\hit@tocsechook{##1}\def\hit@tocsubhook{##2}%
    \ifnum\@tempcnta<3
      \setbox\hit@outbox=\vbox{\hsize=\textwidth\tableofcontents}%
    \else
      \setbox\hit@outbox=\vbox{\hsize=\textwidth\noindent
        \begin{minipage}[t]{.47\textwidth}\hit@ol@callA\end{minipage}%
        \hfill
        \begin{minipage}[t]{.47\textwidth}\hit@ol@callB\end{minipage}\par}%
    \fi}%
  \hit@ol@try{}{}%
  \ifdim\dimexpr\ht\hit@outbox+\dp\hit@outbox\relax>\hit@secavail
    \hit@ol@try{\small}{\footnotesize}%
  \fi
  \ifdim\dimexpr\ht\hit@outbox+\dp\hit@outbox\relax>\hit@secavail
    \hit@ol@try{\footnotesize}{\scriptsize}%
  \fi
  \ifdim\dimexpr\ht\hit@outbox+\dp\hit@outbox\relax>\hit@secavail
    \hit@scaleboxto\hit@outbox{\hit@secavail}%
  \fi
  \noindent\box\hit@outbox}

% 取第 n 条的标题与目标，并按目标生成链接。
\newcommand{\hit@outlinetitleof}[1]{\hit@gettitle{#1}}
\newcommand{\hit@linkto}[2]{%
  \begingroup
  \edef\hit@tmp@tgt{#1}%
  \ifx\hit@tmp@tgt\@empty
    \endgroup #2%
  \else
    \expandafter\endgroup\expandafter\hyperlink\expandafter{\hit@tmp@tgt}{#2}%
  \fi}

% 首次编译或文档确实没有章节时的明确状态，不留空白页。
\newcommand{\hit@outlineplaceholder}{%
  \begin{frame}[t]{\hit@getoutlinetitle}
    \vskip2mm
    {\usebeamercolor[fg]{hit content muted}%
     \hit@ifoutlinererun
       {重新运行一次编译即可读取章节标题}%
       {未检测到章节}\par}
  \end{frame}}

% 目录渲染：2–6 项且选用版块版式时绘制圆角条目，其余采用列表版式。
\newcommand{\hit@outlinerender}{%
  \hit@ifoutlineempty
    {\hit@outlineplaceholder}%
    {\hit@ifoutlinererun
      {\hit@outlineplaceholder}%
      {\ifhit@outlinesubs
         \hit@outlinerenderlist
       \else
         \ifdefstring{\hit@tocmode}{block}%
           {\hit@outlinerenderblock}%
           {\hit@outlinerenderlist}%
       \fi}}}

\newcommand{\hit@outlinerenderblock}{%
  \hit@ifoutlineblock
    {\hit@outlineblock}%
    {\hit@outlinerenderlist}}

% 版块版式：全页 TikZ 绘制，左侧背景与标题色块由主题给出，右侧圆角横条由公共层排布。
\newcommand{\hit@outlineblock}{%
  \begin{frame}[plain]
    \hit@outlinebuildblock
    \begin{tikzpicture}[remember picture,overlay,x=\paperwidth,y=\paperheight]
      \begin{scope}[shift={(current page.south west)}]
        \hit@outlineblockpaint
        \hit@outlinedrawblock
      \end{scope}
    \end{tikzpicture}
  \end{frame}}

% 绘制单个条目的双胶囊横条（序号格 + 标题格）
\newcommand{\hit@drawcapsulerow}[2]{%
  \usebeamercolor{hit block capsule}%
  \fill[hit block capsule.bg,rounded corners=.0525\paperheight]
    (.455\paperwidth,\dimexpr#2\paperheight-.0525\paperheight\relax) rectangle
    (.530\paperwidth,\dimexpr#2\paperheight+.0525\paperheight\relax);
  \fill[hit block capsule.bg,rounded corners=.0525\paperheight]
    (.547\paperwidth,\dimexpr#2\paperheight-.0525\paperheight\relax) rectangle
    (.945\paperwidth,\dimexpr#2\paperheight+.0525\paperheight\relax);
  \node[text=hit block capsule.fg,font=\bfseries\fontsize{12}{14}\selectfont,inner sep=0pt]
    at (.4925\paperwidth,#2\paperheight)
    {\hit@outlinelink{#1}{\hit@twodigits{#1}}};
  \node[inner sep=0pt,text=hit block capsule.fg,font=\bfseries\fontsize{11.5}{12}\selectfont]
    at (.746\paperwidth,#2\paperheight)
    {\parbox[c][.105\paperheight][c]{.345\paperwidth}{\centering\strut
      \hit@outlinelink{#1}{\hit@outlinetitleof{#1}}\strut}};%
}

\newcommand{\hit@outlinelistframe}[3]{%
  \begin{frame}[t]
    \vskip1mm
    \hit@drawlistheader{#1}%
    \hit@outlinelistbody{#2}{#3}%
  \end{frame}}

\newcommand{\hit@outlinerow}[1]{%
  \hit@tocrow{\hit@twodigits{#1}}%
    {\hit@outlinelink{#1}{\hit@outlinetitleof{#1}}}%
  \ifhit@outlinesubs
    \hit@rendersubsections{#1}%
  \fi}

\providecommand{\hit@drawlistheader}[1]{%
  {\usebeamerfont{hit outline title}\usebeamercolor[fg]{structure}%
   \hit@getoutlinetitle\ifnum#1>1\relax\space\mdseries\small（续）\fi\par}%
  \vskip2mm{\usebeamercolor[fg]{hit outline rule}\hrule height .8pt}%
  \vskip4mm}

\newcommand{\hit@rendersubsections}[1]{%
  \hit@subsecsdo{#1}{\hit@tocsubrow}}
\newcommand{\hit@tocsubrow}[2]{%
  \par\nointerlineskip\noindent\hspace{6mm}%
  {\usebeamercolor[fg]{hit content muted}\usebeamerfont{section in toc}%
   \raisebox{.18ex}{\scriptsize$\circ$}\hspace{.5em}%
   \hit@linkto{#2}{#1}}\par\vspace{2mm}}

\newcommand{\hit@OutlineSlide@academic}{%
  \begingroup
  \hit@collectsections
  \ifhit@outlinesubs\hit@collectsubsections\fi
  \hit@outlinerender
  \endgroup}

\newcommand{\OutlineSlide}{%
  \ifdefined\hit@theme@loaded
    \hit@OutlineSlide@pick
  \else
    \hit@OutlineSlide@plain
  \fi}
\newcommand{\hit@OutlineSlide@pick}{%
  \ifdefined\hit@theme@classic
    \let\hit@ol@next\hit@OutlineSlide@classic
  \else
    \ifdefined\hit@theme@academic
      \let\hit@ol@next\hit@OutlineSlide@academic
    \else
      \let\hit@ol@next\hit@OutlineSlide@themed
    \fi
  \fi
  \hit@ol@next}
\newcommand{\hit@OutlineSlide@plain}{%
  \begin{frame}{\hitoutlinetitle}\tableofcontents\end{frame}}
\newcommand{\hit@OutlineSlide@themed}{%
  \begingroup
  \stepcounter{hit@front}\hit@frontmattertrue
  \setbeamertemplate{headline}{}%
  \hit@ol@settemplates
  \begin{frame}[t,noframenumbering]
    \vskip2mm
    \setbox\@tempboxa=\hbox{{\usebeamerfont{hit outline title}%
      \usebeamercolor[fg]{frametitle}\hitoutlinetitle}}%
    \hit@secavail=\dimexpr\textheight-\ht\@tempboxa-\dp\@tempboxa-2mm-1.6mm-6mm-8mm\relax
    \begin{minipage}[b]{\dimexpr\textwidth-.24\paperwidth\relax}%
      \box\@tempboxa
    \end{minipage}%
    \hfill
    \begin{minipage}[b]{.22\paperwidth}%
      \raggedleft\includegraphics[width=.21\paperwidth]{\hitvipath hit-vi-motto}%
    \end{minipage}\par
    \vskip1.6mm
    {\color{hitprimary}\hrule height .8pt}%
    \vskip6mm
    \hit@outlinetoc
  \end{frame}
  \endgroup}

% 经典主题的目录页
\newcommand{\hit@OutlineSlide@classic}{%
  \begin{frame}[plain,noframenumbering]{\hitoutlinetitle}
    \tableofcontents[sectionstyle=show,subsectionstyle=show/shaded/hide,subsubsectionstyle=show/shaded/hide]
  \end{frame}}

% ------------------------------------------------------------- focus slide ----
\newcommand{\FocusSlide}[2][]{%
  \ifdefined\hit@theme@loaded
    \hit@FocusSlide@pick{#1}{#2}%
  \else
    \hit@FocusSlide@plain{#1}{#2}%
  \fi}
\newcommand{\hit@FocusSlide@pick}[2]{%
  \ifdefined\hit@theme@classic
    \let\hit@focus@next\hit@FocusSlide@classic
  \else
    \ifdefined\hit@theme@academic
      \let\hit@focus@next\hit@FocusSlide@academic
    \else
      \let\hit@focus@next\hit@FocusSlide@themed
    \fi
  \fi
  \hit@focus@next{#1}{#2}}
\newcommand{\hit@FocusSlide@plain}[2]{%
  \begin{frame}[c,plain,noframenumbering]\centering
    \hit@iffocuslabel{#1}{{\Large #1\par\vskip3mm}}{}%
    {\Large #2\par}%
  \end{frame}}
\newcommand{\hit@FocusSlide@academic}[2]{%
  \begingroup\hit@focuspage{#1}{#2}\endgroup}
\newcommand{\hit@FocusSlide@themed}[2]{%
  \begingroup
  \setbeamercolor{background canvas}{bg=hitprimary}%
  \setbeamertemplate{background}{%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      \hit@navinbglight
    \end{tikzpicture}}%
  \begin{frame}[c,plain,noframenumbering]
    \centering
    \hit@iffocuslabel{#1}{{\color{hitneutrallightest}\large #1\par\vskip2mm}}{}%
    {\color{hitneutrallightest}\Large #2\par}%
  \end{frame}
  \endgroup}

\newcommand{\hit@FocusSlide@classic}[2]{%
  \begingroup
  \setbeamercolor{background canvas}{bg=hitprimary}%
  \begin{frame}[c,plain,noframenumbering]
    \centering
    \hit@iffocuslabel{#1}{{\color{hitneutrallightest}\large #1\par\vskip2mm}}{}%
    {\color{hitneutrallightest}\Large #2\par}%
  \end{frame}
  \endgroup}

% -------------------------------------------------------------- end slides ----
\newcommand{\EndSlide}[1]{%
  \ifdefined\hit@theme@loaded
    \hit@EndSlide@pick{#1}%
  \else
    \hit@EndSlide@plain{#1}%
  \fi}
\newcommand{\hit@EndSlide@pick}[1]{%
  \ifdefined\hit@theme@classic
    \let\hit@end@next\hit@EndSlide@classic
  \else
    \ifdefined\hit@theme@academic
      \let\hit@end@next\hit@EndSlide@academic
    \else
      \let\hit@end@next\hit@EndSlide@themed
    \fi
  \fi
  \hit@end@next{#1}}
\newcommand{\hit@EndSlide@plain}[1]{%
  \begin{frame}[c,plain,noframenumbering]\centering{\LARGE\bfseries #1\par}\end{frame}}
\newcommand{\hit@EndSlide@academic}[1]{%
  \begingroup\hit@endpage{#1}\endgroup}
\newcommand{\hit@EndSlide@themed}[1]{%
  \begingroup
  \setbeamertemplate{background}{%
    \begin{tikzpicture}
      \useasboundingbox (0,0) rectangle (\paperwidth,\paperheight);
      \node[anchor=south west,inner sep=0] at (0,0)
        {\includegraphics[width=\paperwidth]{\hitvipath hit-vi-mainbuilding-outline}};
      \hit@navinbg
    \end{tikzpicture}}%
  \begin{frame}[t,plain,noframenumbering]
    \vspace*{.075\paperheight}%
    \noindent\hspace*{\hit@tpindent}%
    \includegraphics[width=4.2cm]{\hitvipath hit-vi-logo-vertical}\par
    \vspace*{.055\paperheight}%
    \noindent\hspace*{\hit@tpindent}%
    \begin{minipage}{.44\paperwidth}\raggedright
      {\LARGE\bfseries\color{hitprimary}#1\par}%
    \end{minipage}%
  \end{frame}
  \endgroup}

\newcommand{\hit@EndSlide@classic}[1]{%
  \begin{frame}[c,plain,noframenumbering]
    \centering
    {\Huge #1\par}%
  \end{frame}}

% ------------------------------------------------------------ 手动目录 ====
\newcommand{\AgendaItem}{%
  \PackageError{beamercmdhit}{\string\AgendaItem\space 只能用在 \string\AgendaSlide\space 内}%
    {把条目放进 \string\AgendaSlide{...} 的参数里。}}
\newcommand{\AgendaSlide}[2][]{%
  \ifdefined\hit@theme@loaded
    \hit@AgendaSlide@themed[#1]{#2}%
  \else
    \hit@AgendaSlide@plain[#1]{#2}%
  \fi}
\newcommand{\hit@AgendaSlide@plain}[2][]{%
  \begin{frame}{\hitoutlinetitle}#2\end{frame}}
\newcommand{\hit@AgendaSlide@themed}[2][]{%
  \begingroup
  \hit@outlineclear
  \renewcommand{\AgendaItem}[2][]{%
    \hit@outlinemanualadd{##1}{##2}}%
  \hit@outlinemanualoptions{#1}%
  #2%
  \hit@validatemanual
  \hit@outlineblock
  \endgroup}

\mode<all>
