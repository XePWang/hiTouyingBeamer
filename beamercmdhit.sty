\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercmdhit}[2026/10/01 v2.1 hiTouyingBeamer Academic commands]
\newcommand{\hit@english}{Academic Presentation}
\newcommand{\englishtitle}[1]{\renewcommand{\hit@english}{#1}}
\newcommand{\hit@source}{}
\newcommand{\titlecontext}[1]{\renewcommand{\hit@source}{#1}}
\newcommand{\TitleSlide}{%
  \begin{frame}[plain]
    \vspace{.1cm}
    \begin{center}\includegraphics[width=4.4cm]{\hit@logo}\end{center}
    \vspace{.22cm}
    \begin{beamercolorbox}[wd=\textwidth,sep=.4cm,center]{palette primary}
      {\fontsize{23}{30}\selectfont\bfseries\inserttitle\par}
      \vspace{.38cm}
      {\fontsize{12.1}{16}\selectfont\hit@english\par}
    \end{beamercolorbox}
    \vspace{.22cm}
    \begin{center}\smalltext
      \hit@source\par\vspace{.14cm}\insertauthor\par\smallskip
      \insertinstitute\par\smallskip\insertdate
    \end{center}
  \end{frame}}
\RequirePackage{hit-agenda}
\newcommand{\FocusSlide}[2][]{%
  \begingroup
  \setbeamercolor{background canvas}{bg=brand}
  \begin{frame}[plain]
    \color{white}\vspace{6mm}
    {\fontsize{10}{14}\selectfont\bfseries #1\par}\vspace{7mm}
    {\fontsize{25}{34}\selectfont\bfseries #2\par}\vspace{6mm}
    {\color{cyan}\rule{3cm}{2pt}}
  \end{frame}\endgroup}
\newcommand{\EndSlide}[1]{%
  \begin{frame}[plain]
    \centering\includegraphics[width=4.4cm]{\hit@logo}\par\vspace{.9cm}
    {\color{brand}\fontsize{26}{34}\selectfont\bfseries #1\par}
    \vspace{.4cm}{\color{muted}\insertshorttitle\par}
  \end{frame}}
\newcommand{\hitappendix}{\appendix\renewcommand{\hit@nav}{\hfill\color{muted}APPENDIX\hspace{.4cm}}}
\newcommand{\subhead}[1]{\par{\color{brand}\bfseries #1}\par\vspace{1.4mm}}
\newcommand{\captiontext}[1]{{\fontsize{7.7}{10}\selectfont\color{muted}#1\par}}
\newcommand{\insight}[1]{\par\vspace{2mm}\noindent\colorbox{pale}{\parbox{\dimexpr\linewidth-2\fboxsep}{\vspace{.8mm}\color{brand}\bfseries\fontsize{9}{12}\selectfont #1\vspace{.8mm}}}\par}
\newsavebox{\hit@notebox}
\newcommand{\notebox}[1]{%
  \par\vspace{1.5mm}\noindent
  \sbox{\hit@notebox}{\begin{minipage}[t]{\dimexpr\linewidth-8pt}\fontsize{8}{11}\selectfont #1\end{minipage}}%
  {\color{risk}\rule[-\dp\hit@notebox]{2pt}{\dimexpr\ht\hit@notebox+\dp\hit@notebox\relax}}%
  \hspace{1.5mm}\usebox{\hit@notebox}\par}
\newcommand{\fig}[2][]{\par\noindent\includegraphics[width=\linewidth,#1]{assets/figures/#2.pdf}\par}
\newcommand{\metric}[3]{\begin{minipage}[t]{#1}\color{brand}\fontsize{24}{28}\selectfont\bfseries #2\par\vspace{1.5mm}\color{muted}\fontsize{8.3}{11}\selectfont\mdseries #3\end{minipage}}
\newcommand{\smalltext}{\fontsize{8.5}{11.5}\selectfont}
\newcommand{\bodytext}{\fontsize{9.5}{13}\selectfont\setlength{\abovedisplayskip}{5pt}\setlength{\belowdisplayskip}{5pt}\setlength{\jot}{3pt}}
\newcommand{\minitext}{\fontsize{7.5}{10}\selectfont}
\newenvironment{denseitems}{\begin{itemize}\setlength\itemsep{2.6mm}\setlength\parskip{0pt}}{\end{itemize}}
